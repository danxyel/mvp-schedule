# Variables de entorno del frontend (Vite)
# Copia este archivo a .env y ajusta los valores si es necesario.
# Vite solo expone variables que empiezan con VITE_ (documentación: https://vitejs.dev/guide/env-and-mode)

# URL base de la API backend (FastAPI).
# En desarrollo no hace falta: el default es http://localhost:8000.
# En producción apunta a la URL del backend (ej. https://tu-api.onrender.com).
VITE_API_URL=http://localhost:8000
