# Copiar este archivo como .env y llenar los valores reales
# NUNCA commitear el .env real a git

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/mvp_schedule

# JWT — generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_32_CHARS

# Fernet base64 para cifrar secrets de tenant (requerida) — generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_SECRETS_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_FERNET_BASE64

# Entorno: development (default) expone Swagger; production lo deshabilita
ENV=development

# Orígenes CORS permitidos, separados por coma.
# Producción: poner la URL real del frontend (ej. https://tu-app.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Origen público del frontend — se usa para armar links en correos
# (reclamar/activar cuenta). Producción: la URL real del frontend.
FRONTEND_URL=http://localhost:5173

# Mostrar queries SQL en consola (solo desarrollo)
SQL_ECHO=false
