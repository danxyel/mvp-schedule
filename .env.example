# Copiar este archivo como .env y llenar los valores reales
# NUNCA commitear el .env real a git

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/mvp_schedule

# JWT — generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_32_CHARS

# Mostrar queries SQL en consola (solo desarrollo)
SQL_ECHO=false

# Entorno
ENVIRONMENT=development
